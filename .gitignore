# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template
!.env.example

# Firebase / Google Cloud credential downloads (keys belong in .env.local)
*-firebase-adminsdk-*.json
service-account*.json
client_secret*.json
credentials*.json
*.key
*.p12
*.p8
.firebase/
firebase-debug*.log

# AI tooling: Claude Code settings, the impeccable design tool and its cache, personal notes
.claude/
.impeccable/
CLAUDE.local.md

# editors and logs
.vscode/
.idea/
*.log

# exported iOS Shortcuts (a v1 Shortcut has the Apps Script URL built in)
*.shortcut
# …except the hosted one the site serves: it has only hisabo-app's address, each person's key is pasted in
!public/hisabo.shortcut

# private planning notes
project_arch.md
