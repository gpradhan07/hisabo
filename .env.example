# ── Google Sheet connection ─────────────────────────────────────
# The web app URL your iOS Shortcut posts to (ends in /exec)
APPS_SCRIPT_URL=
# The key printed by setupDashboardKey() in Apps Script
DASHBOARD_KEY=

# ── Dashboard login ─────────────────────────────────────────────
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Random secret that signs the login cookie (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Live updates (Pusher) ───────────────────────────────────────
# Run setupLiveUpdates() in Apps Script; it prints these three lines.
# While they're empty the dashboard still works, it just updates when you open it.
PUSHER_KEY=
PUSHER_CLUSTER=
PUSHER_CHANNEL=

# ── Optional ────────────────────────────────────────────────────
CURRENCY=INR
# Monthly spending budget, enables the budget ring (leave empty to hide)
MONTHLY_BUDGET=

# ─── hisabo v2 (hosted, Firebase) — leave empty to run as above ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SHORTCUT_ICLOUD_URL=
